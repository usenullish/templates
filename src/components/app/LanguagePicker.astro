---
import { ChevronDown } from "@lucide/astro";
import {LANGUAGES} from "../../constants";
---

<div class="relative">
    <select
            id="lang"
            aria-label="Language"
            class="h-8 appearance-none rounded-none bg-transparent pr-8 pl-3 text-sm hover:bg-neutral-100 focus-visible:outline-none dark:border-white/15 dark:hover:bg-neutral-800 dark:[&>option]:bg-neutral-900"
    >
        {LANGUAGES.map(({ lang, label }) => <option value={lang}>{label}</option>)}
    </select>
    <ChevronDown class="pointer-events-none absolute top-1/2 right-2.5 size-4 -translate-y-1/2 text-neutral-500 dark:text-neutral-400" />
</div>

<script>
    import {DEFAULT_LANGUAGE, LANGUAGES} from "../../constants";

    const currentLang = (): string => {
        const {
            location: { search },
        } = window;
        const urlParams = new URLSearchParams(search);
        const selectedLang = urlParams.get("lang") ?? DEFAULT_LANGUAGE;

        return LANGUAGES.find(({ lang }) => lang === selectedLang)?.lang ?? DEFAULT_LANGUAGE;
    };

    const updateNavigation = ({lang}: {lang: string}) => {
        const {location: {search, pathname}} = window;
        const urlParams = new URLSearchParams(search);
        urlParams.set("lang", lang);

        const newUrl = `${pathname}?${urlParams.toString()}`;
        history.pushState({}, '', newUrl);
    }

    const reloadTemplate = () => {
        const $event = new CustomEvent("nullish:reload", {
            bubbles: true
        });
        document.dispatchEvent($event);
    }

    const selectLanguage = () => {
        const lang = document.querySelector<HTMLSelectElement>("#lang")?.value ?? DEFAULT_LANGUAGE;

        updateNavigation({lang});
        reloadTemplate();
    }

    const initLanguagePicker = () => {
        const select = document.querySelector<HTMLSelectElement>("#lang");

        if (select === null) {
            console.error("Unexpected: No language select?")
            return;
        }

        select.addEventListener("change", selectLanguage);
        select.value = currentLang();
    }

    document.addEventListener("DOMContentLoaded", initLanguagePicker);
</script>